def f(x):
    return x ** 2
    
def df(x):
    return 2 * x

def plot(f, df):
    # Hint: Use np.linspace()
    x = np.linspace(-15, 16, 100)
    y = f(np.array(x))
    y8, d8 = f(8), df(8)
    y0, d0 = f(0), df(0)
    l8 = d8 * (x - 8)  + y8
    l0 = d0 * (x - 0) + y0
    plt.figure(figsize = (5, 5))
    plt.plot(x, y)
    plt.plot(x, l0)
    plt.plot(x, l8)
    plt.show()

plot(f, df)





from mpl_toolkits.mplot3d import axes3d

u = np.linspace(1.5 * np.pi, -1.5 * np.pi, 100)
# Return 100 equidistant points between 1.5pi and -1.5pi
[x, y] = np.meshgrid(u, u)
# Return a list of coordinate matrices [x, y] from coordinate vectors u.
squared = np.sqrt(x.flatten() ** 2 + y.flatten() ** 2)
z = np.cos(squared)
# Return the cos value of squared
z = z.reshape(x.shape)
# Return the z reshaped into the shape of x

fig = plt.figure(figsize = (6, 6))
ax = fig.add_subplot(111, projection = '3d')
# Return a coordinate axis ax with 1 number of subgraphs and a 3d projection form
ax.plot_wireframe(x, y, z, rstride = 5, cstride = 5, lw = 2)
# Return to the 3D wireframe, with 5 points in each row and column
ax.view_init(elev = 60, azim = 25)
# Return a view of 25° rotation along the Z-axis and 60° rotation along the Y-axis
plt.savefig("figure1.png")
